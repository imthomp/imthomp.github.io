---
import type { Publication } from "../data/publications";

interface Props {
	pub: Publication;
}
const { pub } = Astro.props;
const linkClass = "font-mono text-xs text-accent underline decoration-border underline-offset-4";
---

{
	(pub.url || pub.code) && (
		<div class="mt-2 flex gap-4">
			{pub.url && <a href={pub.url} class={linkClass}>Paper</a>}
			{pub.code && <a href={pub.code} class={linkClass}>Code</a>}
		</div>
	)
}
