---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Email from "../components/Email.astro";
import { site } from "../data/site";
import { publications } from "../data/publications";
import isaacPhoto from "../assets/isaac.jpg";

const featured = publications.slice(0, 3);

const tagColor: Record<string, string> = {
	red: "text-tag-red",
	green: "text-tag-green",
	blue: "text-tag-blue",
	yellow: "text-tag-yellow",
};
---

<Layout title="About">
	<div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:justify-between">
		<div class="flex-1">
			<p class="font-mono text-xs uppercase tracking-wide text-accent">
				PhD Student, Computer Science, BYU
			</p>
			<h1 class="mt-3 max-w-[18ch] font-display text-4xl font-semibold leading-tight">
				{site.tagline}
			</h1>
		</div>
		<Image
			src={isaacPhoto}
			alt="Isaac Thompson"
			width={176}
			height={264}
			class="w-36 shrink-0 border border-text object-cover sm:w-44"
		/>
	</div>

	<p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-text-muted">
		{site.blurb}
	</p>

	<div class="mt-6 flex flex-wrap font-mono text-[11px] uppercase tracking-wide">
		{
			site.researchInterests.map((interest, i) => (
				<span class={`${tagColor[interest.color]} ${i > 0 ? "border-l border-border pl-3 ml-3" : ""}`}>
					{interest.label}
				</span>
			))
		}
	</div>

	<div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
		<Email showAddress class="text-text underline decoration-border underline-offset-4 hover:text-accent" />
		<a href={site.links.scholar} class="text-text underline decoration-border underline-offset-4 hover:text-accent">Scholar</a>
		<a href={site.links.github} class="text-text underline decoration-border underline-offset-4 hover:text-accent">GitHub</a>
		<a href={site.links.linkedin} class="text-text underline decoration-border underline-offset-4 hover:text-accent">LinkedIn</a>
		<a href="/cv" class="text-text underline decoration-border underline-offset-4 hover:text-accent">CV</a>
	</div>

	<section class="mt-16">
		<div class="flex items-baseline justify-between border-b border-border pb-2.5">
			<h2 class="font-mono text-[11px] uppercase tracking-widest text-accent">
				Selected Publications
			</h2>
			<a href="/research" class="font-mono text-[11px] uppercase tracking-wide text-text-muted hover:text-accent">
				All research &gt;
			</a>
		</div>
		<ol class="divide-y divide-border">
			{
				featured.map((pub, i) => (
					<li class="grid grid-cols-[2rem_1fr_auto] items-baseline gap-4 py-4">
						<span class="font-mono text-xs text-text-muted">{String(i + 1).padStart(2, "0")}</span>
						<div>
							<h3 class="font-display font-semibold">{pub.title}</h3>
							<p class="mt-1 max-w-[54ch] text-sm leading-relaxed text-text-muted">{pub.description}</p>
						</div>
						<span class="whitespace-nowrap text-right font-mono text-[10px] uppercase tracking-wide text-text-muted">
							{pub.venue}
						</span>
					</li>
				))
			}
		</ol>
	</section>

	<section class="mt-16">
		<h2 class="border-b border-border pb-2.5 font-mono text-[11px] uppercase tracking-widest text-accent">
			Currently
		</h2>
		<ul class="mt-5 list-inside list-disc space-y-2 text-text-muted marker:text-accent">
			<li>
				Research Assistant in the <a href={site.orgs.matrix} class="text-text underline decoration-border underline-offset-4 hover:text-accent">BYU MATRIX Lab</a>, advised by
				Dr. Eric Ringger
			</li>
			<li>MT Research Engineer Intern at the <a href={site.orgs.bhroberts} class="text-text underline decoration-border underline-offset-4 hover:text-accent">B. H. Roberts Foundation</a></li>
			<li>Looking for a <span class="text-text">Summer 2027 research internship</span></li>
		</ul>
	</section>
</Layout>
