---
import Layout from "../layouts/Layout.astro";
import { publications } from "../data/publications";
import { site } from "../data/site";
---

<Layout title="Research" description="Publications and research projects by Isaac Thompson.">
	<p class="font-mono text-xs uppercase tracking-wide text-accent">Research</p>
	<h1 class="mt-3 max-w-2xl font-display text-3xl font-semibold leading-tight">
		Low-resource MT, multilingual NLP, and model interpretability
	</h1>
	<p class="mt-4 max-w-2xl text-[17px] leading-relaxed text-text-muted">
		With a focus on the languages and communities that current language technology serves worst.
		Full list also available on{" "}
		<a href={site.links.scholar} class="text-accent underline decoration-border underline-offset-4">Google Scholar</a>.
	</p>

	<section class="mt-14">
		<h2 class="border-b border-border pb-2.5 font-mono text-[11px] uppercase tracking-widest text-accent">
			Publications
		</h2>
		<ol class="divide-y divide-border">
			{
				publications.map((pub, i) => (
					<li class="grid grid-cols-[2rem_1fr_auto] items-baseline gap-4 py-5">
						<span class="font-mono text-xs text-text-muted">{String(i + 1).padStart(2, "0")}</span>
						<div>
							<h3 class="font-display font-semibold">{pub.title}</h3>
							<p class="mt-0.5 font-mono text-[10px] uppercase tracking-wide text-text-muted">{pub.role}</p>
							<p class="mt-2 max-w-[58ch] text-sm leading-relaxed text-text-muted">{pub.description}</p>
							<div class="mt-2 flex gap-4">
								{pub.url && (
									<a
										href={pub.url}
										class="inline-block font-mono text-xs text-accent underline decoration-border underline-offset-4"
									>
										Paper
									</a>
								)}
								{pub.code && (
									<a
										href={pub.code}
										class="inline-block font-mono text-xs text-accent underline decoration-border underline-offset-4"
									>
										Code
									</a>
								)}
							</div>
						</div>
						<span class="whitespace-nowrap text-right font-mono text-[10px] uppercase tracking-wide text-text-muted">
							{pub.venue}
						</span>
					</li>
				))
			}
		</ol>
	</section>
</Layout>
